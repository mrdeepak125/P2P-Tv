# ==============================================================================
# ScreenRoom - Git Ignore Rules
# Security & Privacy: Prevents secret leakage, uploads, caches & build artifacts
# ==============================================================================

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js

# Environment Variables & Private Secrets (DO NOT REMOVE)
# Protects your Cloudflare R2 tokens, Mongo URIs, and API keys
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
server/.env
client/.env
!.env.example
!server/.env.example
!client/.env.example

# Local Uploads & Room Storage State (Keeps user data private)
server/uploads/*
!server/uploads/.gitkeep
server/data/*
!server/data/.gitkeep

# Production Builds & Bundler Caches
dist/
dist-ssr/
client/dist/
build/
.cache/
.parcel-cache/
.vite/

# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Testing & Coverage
coverage/
.nyc_output/

# Antigravity system logs & tasks
.system_generated/
scratch/

