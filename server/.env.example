PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
UPLOAD_MAX_SIZE_MB=250

# Optional MongoDB URI (falls back to local atomic JSON store if not set)
MONGO_URI=mongodb://localhost:27017/screenroom

# Cloudflare R2 Object Storage (screentv)
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_BUCKET_NAME=screentv
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
# Optional: Public R2 URL or Custom Domain if enabled in Cloudflare dashboard
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
